---
import Header from "../components/Header.astro";
import QuestLog from "../components/QuestLog.astro";
import Rift from "../components/Rift.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";

// Counts for the side-quests teaser under the portal.
const projects = await getCollection("projects", ({ data }) => !data.draft).catch(() => []);
const productCount = projects.filter((p) => p.data.kind === "product").length;
const gameCount = projects.filter((p) => p.data.kind === "game").length;
---
<html lang="en" data-world="product">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/site.css" />
    <ClientRouter />
    <style>
      :target { scroll-margin-top: 110px; }

      main.home {
        position: relative;
      }

      /* ============== HERO ============== */
      .hero {
        position: relative;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: clamp(24px, 4vw, 64px);
        align-items: end;
        padding: clamp(48px, 8vw, 120px) 0 clamp(60px, 10vw, 120px);
        min-height: calc(100vh - 110px);
      }

      .hero-mark {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--muted-strong);
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: clamp(14px, 2vw, 28px);
      }

      .hero-mark::before {
        content: "";
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--accent);
        box-shadow: 0 0 0 4px var(--accent-soft);
        animation: blink 2.6s ease-in-out infinite;
      }

      @keyframes blink {
        0%, 60%, 100% { opacity: 1; }
        30% { opacity: 0.25; }
      }

      .hero h1 {
        font-family: var(--font-display);
        font-size: clamp(3.2rem, 9.5vw, 8.5rem);
        line-height: 0.9;
        letter-spacing: -0.04em;
        margin: 0 0 clamp(18px, 3vw, 32px);
        color: var(--text);
      }

      .hero h1 .line { display: block; }

      .hero h1 .accent {
        color: var(--accent);
        padding-right: 0.1em;
      }

      .hero-tagline {
        font-family: var(--font-body);
        font-size: clamp(1.05rem, 1.6vw, 1.35rem);
        line-height: 1.5;
        max-width: 46ch;
        color: var(--text-soft);
        margin: 0 0 clamp(24px, 4vw, 40px);
      }

      .hero-tagline strong {
        font-weight: 600;
        color: var(--text);
      }

      .hero-ctas {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }

      /* Photo (kept from the old index) */
      .hero-photo {
        position: relative;
        justify-self: end;
        width: 100%;
        max-width: 420px;
        aspect-ratio: 4 / 5;
      }

      .hero-photo-frame {
        position: absolute;
        inset: 0;
        border: 2px solid var(--ink);
        border-radius: 4px;
        overflow: hidden;
        background: var(--card);
        transform: rotate(-1.5deg);
        box-shadow: 14px 14px 0 0 var(--ink);
        transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
      }

      .hero-photo:hover .hero-photo-frame {
        transform: rotate(0deg) translate(-4px, -4px);
        box-shadow: 18px 18px 0 0 var(--accent);
      }

      .hero-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .hero-photo-tape {
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%) rotate(-2deg);
        width: 120px;
        height: 28px;
        background: rgba(0, 255, 209, 0.6);
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        z-index: 2;
      }

      .hero-photo-caption {
        position: absolute;
        bottom: -38px;
        right: 12px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .cartridge {
        position: absolute;
        left: -24px;
        bottom: -24px;
        width: 120px;
        height: 72px;
        background: linear-gradient(180deg, #2b2f44 0%, #1a1d2e 100%);
        border: 2px solid var(--ink);
        border-radius: 4px 4px 8px 8px;
        transform: rotate(-6deg);
        box-shadow: 6px 6px 0 0 var(--ink);
        z-index: 3;
        display: grid;
        grid-template-rows: 1fr auto;
        padding: 8px 10px;
      }

      .cartridge::before {
        content: "";
        background: var(--highlight);
        border: 1px solid var(--ink);
        border-radius: 2px;
      }

      .cartridge-label {
        font-family: var(--font-mono);
        font-size: 0.55rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #cfd1ea;
        text-align: center;
        padding-top: 4px;
      }

      /* ============== SIDE QUESTS PORTAL ============== */
      .portal {
        display: grid;
        grid-template-columns: 1fr minmax(260px, 380px);
        gap: clamp(32px, 6vw, 96px);
        align-items: center;
        padding: clamp(60px, 10vw, 120px) 0 clamp(80px, 12vw, 140px);
        border-top: 1px solid var(--border);
      }

      .portal__kicker {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--muted-strong);
        margin: 0 0 12px;
      }

      .portal h2 {
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 6vw, 4rem);
        line-height: 1;
        letter-spacing: -0.03em;
        margin: 0 0 clamp(16px, 2vw, 24px);
      }

      .portal h2 em {
        color: var(--accent);
      }

      .portal__lede {
        color: var(--text-soft);
        font-size: clamp(1rem, 1.4vw, 1.15rem);
        line-height: 1.55;
        max-width: 48ch;
        margin: 0 0 clamp(18px, 2.4vw, 28px);
      }

      .portal__stats {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .portal__stats li {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted-strong);
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        padding: 6px 12px;
      }

      .portal__stats strong {
        color: var(--text);
        font-weight: 600;
      }

      /* ============== RESPONSIVE ============== */
      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
          gap: 48px;
          padding-top: clamp(32px, 6vw, 60px);
          min-height: auto;
        }
        .hero-photo {
          justify-self: start;
          max-width: 320px;
        }
        .portal {
          grid-template-columns: 1fr;
        }
        .portal__rift {
          width: min(340px, 100%);
          margin: 0 auto;
        }
      }

      @media (max-width: 520px) {
        .hero h1 {
          font-size: clamp(2.8rem, 15vw, 4.6rem);
        }
        .cartridge {
          left: -8px;
        }
      }
    </style>
  </head>

  <body>
    <Header world="home" />

    <main class="container home">
      <!-- ============== HERO: the day job ============== -->
      <section class="hero">
        <div class="hero-copy">
          <div class="hero-mark">
            <span>// main quest · developer relations @ archil</span>
          </div>
          <h1>
            <span class="line"><span class="accent">Luca</span></span>
            <span class="line">Ficano</span>
            <span class="line">Latimer.</span>
          </h1>
          <p class="hero-tagline">
            <strong>Developer Relations at Archil.</strong>
            I help developers build on Archil's cloud file system. Before this:
            forward-deployed engineering at The Sandbox and two summers of game
            design at 505 Games in Milan.
          </p>
          <div class="hero-ctas">
            <a class="btn primary" href="#path">How I got here</a>
            <a class="btn ghost" href="/side-quests" data-rift="side-quests">Side quests →</a>
          </div>
        </div>

        <div class="hero-photo">
          <div class="hero-photo-tape" aria-hidden="true"></div>
          <div class="hero-photo-frame">
            <img src="/images/luca-hero.jpg" alt="Photo of Luca Ficano Latimer" />
          </div>
          <div class="hero-photo-caption" aria-hidden="true">// luca.jpg</div>
          <div class="cartridge" aria-hidden="true">
            <div class="cartridge-label">DEVREL</div>
          </div>
        </div>
      </section>

      <!-- ============== QUEST LOG: Archil ← The Sandbox ← 505 Games ============== -->
      <QuestLog />

      <!-- ============== ONE PORTAL: day job → side quests ============== -->
      <section class="portal" id="side-quests" aria-labelledby="portal-heading">
        <div class="portal__copy">
          <p class="portal__kicker">// off the clock</p>
          <h2 id="portal-heading">
            Then there are the <em>side quests.</em>
          </h2>
          <p class="portal__lede">
            The products I ship and the games I make on my own time live on the
            other side. Step through.
          </p>
          <ul class="portal__stats">
            <li><strong>{productCount}</strong> products</li>
            <li><strong>{gameCount}</strong> games</li>
          </ul>
        </div>
        <div class="portal__rift">
          <Rift
            variant="arcade"
            href="/side-quests"
            label="side quests."
            caption="// step through"
            riftKey="side-quests"
            ariaLabel="Step through the portal to the side quests"
          />
        </div>
      </section>
    </main>
  </body>
</html>
