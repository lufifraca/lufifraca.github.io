---
import Header from "../../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import { CSS_HREF } from "../../consts";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.data.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const isGame = d.kind === "game";
// Every project is a side quest now, so they all live in the dark world.
const world = "arcade";
const backHref = isGame ? "/side-quests#levels" : "/side-quests#products";

const statusLabel = { shipped: "Shipped", "in-flight": "In flight", "on-deck": "On deck" }[d.status];
const facts = [isGame ? "Game" : "Product", String(d.year), isGame ? null : statusLabel].filter(Boolean);
---
<html lang="en" data-world={world}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{d.title} • Luca Ficano Latimer</title>
    <meta name="description" content={d.summary} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href={CSS_HREF} />
    <ClientRouter />
    <style is:global>
      /* ---------- HEADER ---------- */
      .project-back {
        display: inline-block;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted-strong);
        margin-bottom: clamp(24px, 4vw, 40px);
      }

      .project-facts {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 10px;
        margin: 0 0 14px;
        padding: 0;
        list-style: none;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .project-facts li + li::before {
        content: "·";
        margin-right: 10px;
        color: var(--muted);
      }

      .project-head h1 {
        font-size: clamp(2.6rem, 7vw, 4.6rem);
        line-height: 0.95;
        margin: 0 0 18px;
      }

      .project-lede {
        font-size: clamp(1.08rem, 1.7vw, 1.3rem);
        line-height: 1.5;
        max-width: 58ch;
        margin: 0 0 22px;
        color: var(--text-soft);
      }

      .project-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 26px;
        padding: 0;
        list-style: none;
      }

      .project-stack li {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--muted-strong);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 5px 12px;
        background: var(--card);
      }

      .project-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      /* ---------- BODY ----------
         Always visible: the overview, with the demo video beside it when
         there is one. Everything else is a collapsible row underneath. */
      .sheet {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0 clamp(28px, 4vw, 56px);
        margin-top: clamp(32px, 5vw, 52px);
        padding-top: clamp(28px, 4vw, 40px);
        border-top: 1px solid var(--border);
        overflow-wrap: break-word;
      }

      .sheet--media {
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        align-items: start;
      }

      .sheet > * {
        grid-column: 1 / -1;
      }

      .sheet--media > .overview {
        grid-column: 1;
        grid-row: 1;
      }

      .sheet__media {
        grid-column: 2;
        grid-row: 1;
        margin: 0 0 clamp(28px, 4vw, 44px);
      }

      .sheet__media video {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: contain;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: #000;
        box-shadow: var(--shadow);
      }

      .overview .sheet__label {
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 12px;
      }

      .overview {
        padding-bottom: clamp(28px, 4vw, 44px);
      }

      .overview p {
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 66ch;
        margin: 0 0 14px;
      }

      /* ---------- COLLAPSIBLE SECTIONS ---------- */
      .fold {
        border-top: 1px solid var(--border);
      }

      .fold:last-child {
        border-bottom: 1px solid var(--border);
      }

      .fold__title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 4px;
        cursor: pointer;
        list-style: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.05rem, 1.6vw, 1.25rem);
        letter-spacing: -0.01em;
        color: var(--text);
        transition: color 0.2s ease;
      }

      .fold__title::-webkit-details-marker {
        display: none;
      }

      .fold__title:hover {
        color: var(--accent);
      }

      /* plus / minus */
      .fold__title::after {
        content: "+";
        flex: none;
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        border: 1px solid var(--border-strong);
        border-radius: 50%;
        font-family: var(--font-body);
        font-weight: 500;
        font-size: 1.1rem;
        line-height: 1;
        color: var(--accent);
      }

      .fold[open] > .fold__title::after {
        content: "−";
      }

      .fold__body {
        padding: 2px 4px 26px;
      }

      .fold__body > :last-child {
        margin-bottom: 0;
      }

      .sheet p {
        color: var(--text-soft);
      }

      .fold__body p {
        max-width: 72ch;
        line-height: 1.65;
        margin: 0 0 14px;
      }

      .sheet strong {
        color: var(--text);
        font-weight: 600;
      }

      .sheet ul,
      .sheet ol {
        margin: 0 0 14px;
        padding: 0;
        list-style: none;
      }

      .sheet li {
        position: relative;
        padding-left: 20px;
        margin-bottom: 10px;
        color: var(--text-soft);
        line-height: 1.55;
        break-inside: avoid;
      }

      .sheet li::before {
        content: "";
        position: absolute;
        left: 2px;
        top: 0.62em;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: var(--accent);
      }

      /* long lists run in two columns where there is room */
      @media (min-width: 900px) {
        .fold__body > ul,
        .fold__body > ol {
          columns: 2;
          column-gap: 56px;
        }
      }

      .sheet a {
        color: var(--accent);
        text-decoration: underline;
      }

      .sheet table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: 0.92rem;
      }

      .sheet thead {
        display: none;
      }

      .sheet td {
        padding: 9px 24px 9px 0;
        border-bottom: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
        color: var(--text-soft);
      }

      .sheet td:first-child {
        white-space: nowrap;
        font-weight: 600;
        color: var(--text);
      }

      .sheet tr:last-child td {
        border-bottom: 0;
      }

      .sheet pre {
        max-width: 100%;
        overflow-x: auto;
      }

      .sheet img {
        max-width: 100%;
        height: auto;
      }

      /* ---------- LIVE DEMO ---------- */
      .demo-iframe-wrap {
        position: relative;
        width: 100%;
        max-width: 1000px;
        aspect-ratio: 16 / 10;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid var(--border);
        background: var(--bg-soft);
        box-shadow: var(--shadow);
        margin-bottom: 12px;
      }

      .demo-iframe-wrap iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: none;
      }

      .fold__body .demo-fallback {
        font-size: 0.88rem;
        color: var(--muted);
      }

      @media (max-width: 860px) {
        .sheet--media {
          grid-template-columns: minmax(0, 1fr);
        }
        .sheet--media > .overview,
        .sheet__media {
          grid-column: 1;
          grid-row: auto;
        }
        .sheet__media {
          margin-bottom: 24px;
        }
        .sheet td:first-child {
          white-space: normal;
        }
      }
    </style>
  </head>
  <body>
    <Header world={world} />
    <main class="container project">
      <a class="project-back" href={backHref}>← Side quests</a>

      <header class="project-head">
        <ul class="project-facts">
          {facts.map((f) => <li>{f}</li>)}
        </ul>
        <h1>{d.title}</h1>
        <p class="project-lede">{d.summary}</p>
        {d.stack?.length ? (
          <ul class="project-stack" aria-label="Stack">
            {d.stack.map((s) => <li>{s}</li>)}
          </ul>
        ) : null}
        {(d.live || d.repo) && (
          <div class="project-actions">
            {d.live ? <a class="btn primary" href={d.live} target="_blank" rel="noreferrer">{isGame ? "Play" : "Visit site"} ↗</a> : null}
            {d.repo ? <a class="btn" href={d.repo} target="_blank" rel="noreferrer">Repository ↗</a> : null}
          </div>
        )}
      </header>

      <article class:list={["sheet", { "sheet--media": d.video }]}>
        {d.video ? (
          <figure class="sheet__media">
            <video controls preload="metadata" playsinline poster={d.thumb}>
              <source src={d.video} type="video/mp4" />
            </video>
          </figure>
        ) : null}

        <Content />

        {d.demo ? (
          <details class="fold">
            <summary class="fold__title">Live demo</summary>
            <div class="fold__body">
              <div class="demo-iframe-wrap">
                <iframe
                  src={d.demo}
                  title={`${d.title} live demo`}
                  loading="lazy"
                  allow="clipboard-write"
                ></iframe>
              </div>
              <p class="demo-fallback">
                If the demo doesn't load, <a href={d.demo} target="_blank" rel="noreferrer">open it in a new tab</a>.
              </p>
            </div>
          </details>
        ) : null}
      </article>
    </main>
  </body>
</html>
