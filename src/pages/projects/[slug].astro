---
import Header from "../../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import { CSS_HREF } from "../../consts";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.data.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const isGame = d.kind === "game";
// Every project is a side quest now, so they all live in the dark world.
const world = "arcade";
const backHref = isGame ? "/side-quests#levels" : "/side-quests#products";

const statusLabel = { shipped: "Shipped", "in-flight": "In flight", "on-deck": "On deck" }[d.status];
const facts = [isGame ? "Game" : "Product", String(d.year), isGame ? null : statusLabel].filter(Boolean);
---
<html lang="en" data-world={world}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{d.title} • Luca Ficano Latimer</title>
    <meta name="description" content={d.summary} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href={CSS_HREF} />
    <ClientRouter />
    <style is:global>
      main.project {
        max-width: 960px;
      }

      /* ---------- HEADER ---------- */
      .project-back {
        display: inline-block;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted-strong);
        margin-bottom: clamp(24px, 4vw, 40px);
      }

      .project-facts {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 10px;
        margin: 0 0 14px;
        padding: 0;
        list-style: none;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .project-facts li + li::before {
        content: "·";
        margin-right: 10px;
        color: var(--muted);
      }

      .project-head h1 {
        font-size: clamp(2.6rem, 7vw, 4.6rem);
        line-height: 0.95;
        margin: 0 0 18px;
      }

      .project-lede {
        font-size: clamp(1.08rem, 1.7vw, 1.3rem);
        line-height: 1.5;
        max-width: 58ch;
        margin: 0 0 22px;
        color: var(--text-soft);
      }

      .project-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 26px;
        padding: 0;
        list-style: none;
      }

      .project-stack li {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--muted-strong);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 5px 12px;
        background: var(--card);
      }

      .project-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      /* Hero video — full-bleed dark band */
      .demo-hero {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        background: #0d111f;
        padding: 32px 0;
        margin-top: 24px;
        margin-bottom: 32px;
      }
      .demo-hero__inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 28px;
      }
      .demo-hero video {
        display: block;
        width: 100%;
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      }

      /* Placeholder shown when a project has no demo video yet */
      .demo-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 1.5px dashed rgba(255, 255, 255, 0.18);
        border-radius: 12px;
        background:
          repeating-linear-gradient(
            45deg,
            rgba(255, 255, 255, 0.03) 0 10px,
            rgba(255, 255, 255, 0.01) 10px 20px
          );
      }
      .demo-placeholder__play {
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 14px 0 14px 24px;
        border-color: transparent transparent transparent rgba(255, 255, 255, 0.35);
        margin-left: 6px;
        filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.12));
      }
      .demo-placeholder__label {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.45);
      }

      /* ---------- BODY: label on the left, content on the right ---------- */
      .sheet {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr);
        column-gap: clamp(24px, 4vw, 56px);
        margin-top: clamp(28px, 5vw, 48px);
        overflow-wrap: break-word;
      }

      .sheet > * {
        grid-column: 2;
        margin: 0 0 14px;
      }

      /* Section headings become small labels in the left column. */
      .sheet > h2 {
        grid-column: 1;
        font-family: var(--font-body);
        font-size: 0.76rem;
        font-weight: 600;
        line-height: 1.6;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
      }

      /* One rule across both columns at the start of each section. */
      .sheet > h2,
      .sheet > h2 + * {
        margin-top: 14px;
        padding-top: 26px;
        border-top: 1px solid var(--border);
        max-width: none;
      }

      .sheet > h2:first-child,
      .sheet > h2:first-child + * {
        margin-top: 0;
      }

      .sheet p {
        max-width: 64ch;
        line-height: 1.65;
      }

      .sheet strong {
        color: var(--text);
        font-weight: 600;
      }

      .sheet ul,
      .sheet ol {
        padding-left: 0;
        list-style: none;
        display: grid;
        gap: 10px;
      }

      .sheet li {
        position: relative;
        padding-left: 20px;
        color: var(--text-soft);
        line-height: 1.55;
      }

      .sheet li::before {
        content: "";
        position: absolute;
        left: 2px;
        top: 0.62em;
        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: var(--accent);
      }

      .sheet a {
        color: var(--accent);
        text-decoration: underline;
      }

      .sheet table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: 0.92rem;
      }

      .sheet thead {
        display: none;
      }

      .sheet td {
        padding: 9px 24px 9px 0;
        border-bottom: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
        color: var(--text-soft);
      }

      .sheet td:first-child {
        white-space: nowrap;
        font-weight: 600;
        color: var(--text);
      }

      .sheet tr:last-child td {
        border-bottom: 0;
      }

      .sheet pre {
        max-width: 100%;
        overflow-x: auto;
      }

      .sheet img {
        max-width: 100%;
        height: auto;
      }

      /* ---------- LIVE DEMO ---------- */
      .demo-iframe-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid var(--border);
        background: var(--bg-soft);
        box-shadow: var(--shadow);
      }

      .demo-iframe-wrap iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: none;
      }

      .demo-fallback {
        font-size: 0.88rem;
        color: var(--muted);
      }

      @media (max-width: 760px) {
        .sheet {
          display: block;
        }
        .sheet > h2 {
          margin-top: 28px;
          margin-bottom: 12px;
        }
        .sheet > h2 + * {
          margin-top: 0;
          padding-top: 0;
          border-top: 0;
        }
        .sheet td:first-child {
          white-space: normal;
        }
      }

      @media (max-width: 640px) {
        .demo-hero {
          padding: 20px 0;
          margin-top: 16px;
          margin-bottom: 24px;
        }
        .demo-hero__inner {
          padding: 0 16px;
        }
        .demo-hero video {
          border-radius: 8px;
        }
      }
    </style>
  </head>
  <body>
    <Header world={world} />
    <main class="container project">
      <a class="project-back" href={backHref}>← Side quests</a>

      <header class="project-head">
        <ul class="project-facts">
          {facts.map((f) => <li>{f}</li>)}
        </ul>
        <h1>{d.title}</h1>
        <p class="project-lede">{d.summary}</p>
        {d.stack?.length ? (
          <ul class="project-stack" aria-label="Stack">
            {d.stack.map((s) => <li>{s}</li>)}
          </ul>
        ) : null}
        {(d.live || d.repo) && (
          <div class="project-actions">
            {d.live ? <a class="btn primary" href={d.live} target="_blank" rel="noreferrer">{isGame ? "Play" : "Visit site"} ↗</a> : null}
            {d.repo ? <a class="btn" href={d.repo} target="_blank" rel="noreferrer">Repository ↗</a> : null}
          </div>
        )}
      </header>

      {d.video ? (
        <section class="demo-hero">
          <div class="demo-hero__inner">
            <video controls preload="metadata" playsinline>
              <source src={d.video} type="video/mp4" />
            </video>
          </div>
        </section>
      ) : d.demo ? null : (
        <section class="demo-hero demo-hero--empty" aria-label="Demo video coming soon">
          <div class="demo-hero__inner">
            <div class="demo-placeholder">
              <span class="demo-placeholder__play" aria-hidden="true"></span>
              <span class="demo-placeholder__label">Demo capture coming soon</span>
            </div>
          </div>
        </section>
      )}

      <article class="sheet">
        <Content />

        {d.demo ? (
          <>
            <h2>Live demo</h2>
            <div class="demo-iframe-wrap">
              <iframe
                src={d.demo}
                title={`${d.title} live demo`}
                loading="lazy"
                allow="clipboard-write"
              ></iframe>
            </div>
            <p class="demo-fallback">
              If the demo doesn't load, <a href={d.demo} target="_blank" rel="noreferrer">open it in a new tab</a>.
            </p>
          </>
        ) : null}
      </article>
    </main>
  </body>
</html>
