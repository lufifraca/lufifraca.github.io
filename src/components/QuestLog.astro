---
// Quest log — the career track on the landing page.
//
// A level-select rail: one stop per role, oldest on the left, the current
// one (Archil) on the right and selected by default. Picking a stop swaps
// the single panel underneath, so the whole career fits in one screen.
//
// No JavaScript: each stop is a radio input, and the `:checked` state drives
// both the rail highlight and which panel is shown.

interface Stop {
  id: string;
  level: string;
  name: string;
  when: string;
  status: string;
  title: string;
  org: string;
  intro?: string;
  bullets: string[];
  carry?: string;
  image?: { src: string; alt: string };
}

const stops: Stop[] = [
  {
    id: "milan-24",
    level: "LV 01",
    name: "505 Games",
    when: "Summer 2024",
    status: "✓ complete",
    title: "Game Design Intern",
    org: "505 Games · Avantgarden · Milan",
    bullets: [
      "Prototyped building and magic mechanics in UE5: placement rules, decision logic, and visual feedback.",
      "Built 3 dungeon prototype levels from modular UE5 pieces with smart wall and door behaviors.",
      "Authored ~7 Confluence specs with flowcharts and edge cases for engineering handoff.",
      "QA on Brothers: A Tale of Two Sons Remake, including a frame-drop bug with video repro.",
    ],
    carry: "Writing a system down clearly enough that someone else can build it.",
    image: { src: "/images/lucamilan.jpg", alt: "Milan, summer 2024" },
  },
  {
    id: "milan-25",
    level: "LV 02",
    name: "505 Games",
    when: "Summer 2025",
    status: "✓ complete",
    title: "Game Design Intern, round two",
    org: "505 Games · Avantgarden · Among the Trolls",
    bullets: [
      "Owned quest and dialogue flow via the Narrative plugin: 12+ quests and 12+ dialogue sequences with event-driven triggers.",
      "Broke down feature work in Jira and aligned weekly priorities with design leads.",
      "Designed interaction flows and annotated mechanics in Figma for review and engineering handoff.",
      "Collaborated daily in Italian across design, engineering, and QA.",
    ],
    carry: "Owning a feature across design, engineering, and QA, in a second language.",
    image: { src: "/images/505-summer-2025.jpg", alt: "Milan, summer 2025" },
  },
  {
    id: "sandbox",
    level: "LV 03",
    name: "The Sandbox",
    when: "2026 · contract",
    status: "✓ complete",
    title: "Forward Deployed Engineer",
    org: "The Sandbox · Creator Platform",
    bullets: [
      "Primary technical point of contact for high-profile game creators integrating with the engine, APIs, and SDKs, from onboarding through stable integration.",
      "Debugged integration failures end to end: reproduced issues locally, isolated client code from platform behavior, and handed engineering actionable repro packages.",
      "Surfaced undocumented API behaviors and edge cases, and turned them into reports that drove SDK and documentation updates.",
      "Triaged creator-reported issues and feature gaps, and escalated the patterns across accounts to product and engineering.",
    ],
    carry: "Sitting with developers until their integration works, then fixing the docs so the next one doesn't hit it.",
    image: { src: "/images/thesandbox.jpg", alt: "The Sandbox Creator Platform" },
  },
  {
    id: "archil",
    level: "LV 04",
    name: "Archil",
    when: "2026 — now",
    status: "● in progress",
    title: "Developer Relations",
    org: "Archil · full-time",
    intro:
      "The main quest. I work with the developers building on Archil: showing what the platform can do, getting them unstuck, and carrying what they run into back to the team.",
    bullets: [],
  },
];

const current = stops[stops.length - 1].id;
---

<section class="log" id="path" aria-labelledby="log-heading">
  <header class="log__head">
    <div>
      <p class="log__kicker">// quest log</p>
      <h2 id="log-heading">How I got <em>here.</em></h2>
    </div>
    <p class="log__lede">
      Game design taught me to explain systems. Forward-deployed engineering
      put me next to the developers using them. Developer relations is both.
    </p>
  </header>

  <div class="track">
    {stops.map((s) => (
      <input
        class="track__radio"
        type="radio"
        name="quest"
        id={`q-${s.id}`}
        checked={s.id === current}
      />
    ))}

    <div class="track__rail" role="group" aria-label="Pick a role">
      {stops.map((s) => (
        <label class="stop" for={`q-${s.id}`} data-current={s.id === current ? "true" : undefined}>
          <span class="stop__node" aria-hidden="true"></span>
          <span class="stop__level">{s.level}</span>
          <span class="stop__name">{s.name}</span>
          <span class="stop__when">{s.when}</span>
        </label>
      ))}
    </div>

    <div class="track__panels">
      {stops.map((s) => (
        <article class="panel" data-stop={s.id} data-current={s.id === current ? "true" : undefined}>
          <div class="panel__copy">
            <header class="panel__meta">
              <span class="panel__status">{s.status}</span>
              <span>{s.level} · {s.when}</span>
            </header>
            <h3 class="panel__title">
              {s.title} <span>at</span> <em>{s.name}.</em>
            </h3>
            <p class="panel__org">{s.org}</p>
            {s.intro && <p class="panel__intro">{s.intro}</p>}
            {s.bullets.length > 0 && (
              <ul class="panel__list">
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
            {s.carry && (
              <p class="panel__carry">
                <span>carried over</span>
                {s.carry}
              </p>
            )}
          </div>
          {s.image && (
            <figure class="panel__media">
              <img src={s.image.src} alt={s.image.alt} loading="lazy" decoding="async" />
            </figure>
          )}
        </article>
      ))}
    </div>
  </div>

  <p class="log__origin">
    <strong>Start:</strong> B.S. Computer Science, Cal Poly Pomona, Dec 2025.
    Along the way: volunteering at GamesBeat Summit (LA, 2025) and the
    Crossfire Lounge (SF, 2026).
  </p>
</section>

<style>
  .log {
    padding: clamp(56px, 8vw, 100px) 0;
    border-top: 1px solid var(--border);
  }

  .log__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px 48px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .log__kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted-strong);
    margin: 0 0 12px;
  }

  .log h2 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .log h2 em,
  .panel__title em {
    color: var(--accent);
  }

  .log__lede {
    flex: 1 1 320px;
    max-width: 46ch;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--text-soft);
    margin: 0;
  }

  /* ---------- RADIOS (state only) ---------- */
  .track__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* ---------- RAIL ---------- */
  .track__rail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: 18px;
  }

  /* the line the stops sit on */
  .track__rail::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 9px;
    border-top: 2px dashed var(--border-strong);
  }

  .stop {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 3px;
    padding: 0 12px 14px 0;
    cursor: pointer;
    color: var(--muted-strong);
    transition: color 0.2s ease;
  }

  .stop__node {
    width: 20px;
    height: 20px;
    margin-bottom: 10px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--ink);
    transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .stop:hover .stop__node {
    transform: scale(1.15);
  }

  .stop__level {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    color: var(--muted);
  }

  .stop__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1rem, 1.9vw, 1.45rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .stop__when {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stop[data-current] .stop__when::after {
    content: " ●";
    color: var(--accent);
  }

  /* ---------- PANELS ---------- */
  .panel {
    display: none;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
    min-height: 330px;
    background: var(--card);
    border: 1.5px solid var(--ink);
    border-radius: 14px;
    padding: clamp(20px, 3vw, 32px);
    box-shadow: 6px 6px 0 0 var(--ink);
  }

  .panel:has(.panel__media) {
    grid-template-columns: minmax(0, 1fr) minmax(200px, 300px);
  }

  .panel[data-current] {
    box-shadow: 8px 8px 0 0 var(--accent);
  }

  .panel__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .panel__status {
    color: var(--muted-strong);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 4px 10px;
  }

  .panel[data-current] .panel__status {
    color: var(--accent-2);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .panel__title {
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }

  .panel__title span {
    color: var(--muted);
  }

  .panel__org {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-strong);
    margin: 0 0 16px;
  }

  .panel__intro {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    max-width: 60ch;
    margin: 0;
  }

  .panel__list {
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 28px;
  }

  .panel__list li {
    position: relative;
    padding-left: 18px;
    color: var(--text-soft);
    line-height: 1.45;
    font-size: 0.92rem;
  }

  .panel__list li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .panel__carry {
    margin: 0;
    padding-top: 12px;
    border-top: 1px dashed var(--border-strong);
    font-size: 0.98rem;
    color: var(--text);
    max-width: none;
  }

  .panel__carry span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 4px;
  }

  .panel__media {
    margin: 0;
  }

  .panel__media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
  }

  /* ---------- SELECTION: radio → stop + panel ---------- */
  #q-milan-24:checked ~ .track__panels [data-stop="milan-24"],
  #q-milan-25:checked ~ .track__panels [data-stop="milan-25"],
  #q-sandbox:checked ~ .track__panels [data-stop="sandbox"],
  #q-archil:checked ~ .track__panels [data-stop="archil"] {
    display: grid;
  }

  #q-milan-24:checked ~ .track__rail [for="q-milan-24"],
  #q-milan-25:checked ~ .track__rail [for="q-milan-25"],
  #q-sandbox:checked ~ .track__rail [for="q-sandbox"],
  #q-archil:checked ~ .track__rail [for="q-archil"] {
    color: var(--text);
  }

  #q-milan-24:checked ~ .track__rail [for="q-milan-24"] .stop__node,
  #q-milan-25:checked ~ .track__rail [for="q-milan-25"] .stop__node,
  #q-sandbox:checked ~ .track__rail [for="q-sandbox"] .stop__node,
  #q-archil:checked ~ .track__rail [for="q-archil"] .stop__node {
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }

  #q-milan-24:focus-visible ~ .track__rail [for="q-milan-24"],
  #q-milan-25:focus-visible ~ .track__rail [for="q-milan-25"],
  #q-sandbox:focus-visible ~ .track__rail [for="q-sandbox"],
  #q-archil:focus-visible ~ .track__rail [for="q-archil"] {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
    border-radius: 6px;
  }

  /* ---------- ORIGIN ---------- */
  .log__origin {
    margin: 22px 0 0;
    font-size: 0.9rem;
    color: var(--muted-strong);
    max-width: none;
  }

  .log__origin strong {
    color: var(--text);
  }

  @media (max-width: 820px) {
    .panel,
    .panel:has(.panel__media) {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .panel__list {
      grid-template-columns: 1fr;
    }
    .panel__media img {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 520px) {
    .stop {
      padding-right: 6px;
    }
    .stop__name {
      font-size: 0.86rem;
    }
    .stop__when {
      font-size: 0.56rem;
      letter-spacing: 0.04em;
    }
    .stop__level {
      font-size: 0.56rem;
      letter-spacing: 0.1em;
    }
  }
</style>
